# Jenix One API server — required environment for a real deployment.
#
# This file exists because of a real production incident (2026-08-29):
# MQTT_RUNTIME_ENABLED was missing/false on the live VPS, so every device
# command (e.g. QRunlock's unlock) was silently accepted and logged as
# "success" — cooldown check, DB write, activity log all completed — but
# the command was NEVER actually published to the MQTT broker, because
# device.service.ts's dispatch path does `if (bridge) { publish }` with no
# else/error when the bridge is disabled. The code-level default for
# MQTT_RUNTIME_ENABLED (see src/config/env.ts) is `false`, so simply
# forgetting this var on a fresh box reintroduces the exact same bug with
# no error, no crash, no log line — just devices that never respond.
#
# Copy this file to the real secrets location (currently
# /root/secrets/iot-one/api-server.env on the VPS — see
# DEVICE_PACKAGE_RUNTIME.md "VPS locations") and fill in real values.
# Never commit the filled-in file — secrets stay outside git by design.

NODE_ENV=production
PORT=4300

# --- MongoDB ---------------------------------------------------------------
# Required if any *_PERSISTENCE_MODE below is "mongodb" (the default for
# all of them once MONGODB_URI is set at all).
MONGODB_URI=mongodb://USERNAME:PASSWORD@localhost:27017/jenix_iot?authSource=admin

# --- MQTT runtime bridge -----------------------------------------------
# REQUIRED: true in any environment with real devices. If false (or unset),
# the platform never connects to the broker and every device command
# silently no-ops while still reporting HTTP success — see the incident
# note above. Only leave this false for a pure-API/no-hardware deployment.
MQTT_RUNTIME_ENABLED=true
MQTT_URL=mqtt://mqtt.iotsoft.in:1883
MQTT_USERNAME=jenix_platform
MQTT_PASSWORD=CHANGE_ME
# Optional — defaults to jenix-api-<pid> if unset. Set a stable value so
# broker ACLs/logs are easy to correlate with this process across restarts.
MQTT_CLIENT_ID=jenix-api-local
# Internal-only topics (not device-facing) — safe to leave at the defaults.
# MQTT_SCHEDULE_TOPIC=jenix/runtime/schedule
# MQTT_NOTIFICATION_TOPIC=jenix/runtime/notifications

# --- Auth --------------------------------------------------------------
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# --- Feature toggles -----------------------------------------------------
MATTER_RUNTIME_ENABLED=false

# --- Persistence mode per module -----------------------------------------
# Each of these accepts "memory" or "mongodb". If MONGODB_URI is set and a
# mode is left unset, it defaults to "mongodb" — that's correct for a real
# deployment, so in practice you can omit all of these. Listed explicitly
# here so a migration can see every module that exists.
AUTH_PERSISTENCE_MODE=mongodb
HOME_PERSISTENCE_MODE=mongodb
PID_PERSISTENCE_MODE=mongodb
UI_PACKAGE_PERSISTENCE_MODE=mongodb
NURSE_CALL_RECEIVER_PERSISTENCE_MODE=mongodb
SMART_RF_TRANSMITTER_PERSISTENCE_MODE=mongodb
TOKEN_DISPENSER_PERSISTENCE_MODE=mongodb
P10_DISPLAY_PERSISTENCE_MODE=mongodb
SOS_SIREN_PERSISTENCE_MODE=mongodb
DEVICE_PERSISTENCE_MODE=mongodb
PROVISIONING_PERSISTENCE_MODE=mongodb
OTA_PERSISTENCE_MODE=mongodb
API_ACCESS_PERSISTENCE_MODE=mongodb
SCENE_PERSISTENCE_MODE=mongodb
NOTIFICATION_PERSISTENCE_MODE=mongodb

# --- Scene scheduler / workers --------------------------------------------
# Safe to leave at these defaults (also the code's own defaults) unless
# tuning for scale. coordination mode auto-picks mongodb-lock once
# SCENE_PERSISTENCE_MODE=mongodb, so it's also safe to omit.
SCENE_SCHEDULER_ENABLED=true
SCENE_SCHEDULER_COORDINATION_MODE=mongodb-lock
SCENE_SCHEDULER_INTERVAL_MS=30000
SCENE_SCHEDULER_LEASE_MS=60000
SCENE_ACTION_WORKER_ENABLED=true
SCENE_ACTION_WORKER_INTERVAL_MS=5000
SCENE_ACTION_WORKER_BATCH_SIZE=25
SCENE_ACTION_WORKER_VISIBILITY_TIMEOUT_MS=30000
SCENE_RUNTIME_WORKER_ENABLED=true
SCENE_RUNTIME_WORKER_INTERVAL_MS=5000
SCENE_RUNTIME_WORKER_BATCH_SIZE=25
SCENE_RUNTIME_WORKER_VISIBILITY_TIMEOUT_MS=30000

# --- OTA delivery worker ---------------------------------------------------
OTA_DELIVERY_WORKER_ENABLED=true
OTA_DELIVERY_WORKER_INTERVAL_MS=5000
OTA_DELIVERY_WORKER_BATCH_SIZE=25
OTA_DELIVERY_WORKER_VISIBILITY_TIMEOUT_MS=30000
