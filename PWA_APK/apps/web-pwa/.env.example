# Google Sign-In (web PWA). This is the OAuth "Web application" Client ID from
# Google Cloud Console -- it must have https://one.jenix.in listed under
# Authorized JavaScript origins, or the sign-in popup will fail with
# "Error 400: origin_mismatch". Must match GOOGLE_CLIENT_ID on the API server
# (VPS/apps/api-server), since the backend verifies the token's audience
# against that same value.
VITE_GOOGLE_CLIENT_ID=
