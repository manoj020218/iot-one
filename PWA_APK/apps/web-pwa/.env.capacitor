# Used only by `pnpm build:capacitor` (vite --mode capacitor). The
# Capacitor app is served from https://localhost/, which has no backend of
# its own, so every "/api/v1/..." call needs an absolute origin -- see
# src/app/authenticatedRequest.ts's apiOrigin. one.jenix.in is the real,
# nginx-configured API proxy (/api/ -> 127.0.0.1:4300); api.iotsoft.in was
# never actually wired up (no nginx vhost, no cert) despite being referenced
# in VPS/apps/api-server/.env.example's API_PUBLIC_URL -- don't use it.
VITE_API_ORIGIN=https://one.jenix.in
