# ESP-IDF defaults used only by the mixed arduino+espidf provisioning pilot.
# The shipping pure-Arduino env ignores this file.

# Required when arduino-esp32 is used as an ESP-IDF component.
CONFIG_FREERTOS_HZ=1000

# BLE-only host selection for provisioning work.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Security Scheme 2 is the Jenix One standard for provisioning.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=n
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=y
CONFIG_WIFI_PROV_BLE_SEC_CONN=y

# PlatformIO's ESP-IDF builder reparses CMake compiler fragments and currently
# breaks on the space-containing project path when this option emits
# -fmacro-prefix-map=<project>=. Disable it for the pilot env so mixed
# arduino+espidf builds remain stable in the existing workspace.
# CONFIG_COMPILER_HIDE_PATHS_MACROS is not set

# The prov2 pilot currently uses WiFiClientSecure::setInsecure() for OTA and
# does not rely on the global ESP-IDF root certificate bundle yet. Disabling
# the bundle avoids an IDF 5.3.1 build-time embed failure while the mixed
# framework bring-up is still in progress.
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# Match the esp32-c3-devkitm-1 board definition used by the pilot env.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# CONFIG_ESPTOOLPY_FLASHSIZE_DETECT is not set
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
